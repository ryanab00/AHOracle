# Leave blank to use local SQLite (ahoracle.db in the current directory)
# AHORACLE_DB_URL=

# Supabase example
# AHORACLE_DB_URL=postgresql+psycopg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Neon example
# AHORACLE_DB_URL=postgresql+psycopg://user:password@ep-xxx.us-east-2.aws.neon.tech/ahoracle?sslmode=require

# Optional: absolute path to your AHOracle.lua if auto-detect fails
# AHORACLE_SV_FILE=C:\Program Files (x86)\World of Warcraft\_classic_era_\WTF\Account\12345#1\SavedVariables\AHOracle.lua